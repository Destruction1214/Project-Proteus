{
  "diagnostics": {
    "disable": [
      "unresolved-require",
      "undefined-global",
      "unnecessary-if",
      "deprecated",
      "access-invisible",
      "param-type-mismatch",
      "undefined-field",
      "need-check-nil",
      "global-in-non-module",
      "assign-type-mismatch",
      "call-non-callable",
      "type-not-found",
      "undefined-doc-param"
    ]
  }
}